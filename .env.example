# Development values only. Copy to .env and replace before shared deployment.
POSTGRES_DB=queue
POSTGRES_USER=queue_app
POSTGRES_PASSWORD=change-me-for-local-development
DATABASE_URL=postgresql+asyncpg://queue_app:change-me-for-local-development@db:5432/queue
SYNC_DATABASE_URL=postgresql+psycopg://queue_app:change-me-for-local-development@db:5432/queue
REDIS_URL=redis://redis:6379/0
SESSION_TOKEN_SECRET=replace-with-at-least-32-random-characters
DEMO_STAFF_PIN=replace-with-a-demo-pin
DEMO_MOBILE_APP_API_KEY=replace-with-a-demo-integration-key
DEMO_NOTIFICATION_MODE=log
NOTIFICATION_DELIVERY_TIMEOUT_SECONDS=2
NOTIFICATION_POLL_SECONDS=0.5
NOTIFICATION_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60
STAFF_LOGIN_RATE_LIMIT=20
TICKET_WRITE_RATE_LIMIT=60
INTEGRATION_RATE_LIMIT=120
PUBLIC_CLIENT_URL=http://localhost:3000
# Keep loopback by default. Use 0.0.0.0 only on a trusted LAN for phone testing.
FRONTEND_BIND_HOST=127.0.0.1
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
